  "_conventions": "Axis targets and axis sources are objects {neg, pos}. Sign follows SDL: x neg = left, pos = right; y neg = up, pos = down. To bind an axis target to an axis source, write target.neg <- source.neg and target.pos <- source.pos.",
  "paths": {
    "flatpak": {
      "app_id": "org.DolphinEmu.dolphin-emu",
      "config_root": "~/.var/app/org.DolphinEmu.dolphin-emu/config/dolphin-emu/",
      "data_root": "~/.var/app/org.DolphinEmu.dolphin-emu/data/dolphin-emu/",
      "cache_root": "~/.var/app/org.DolphinEmu.dolphin-emu/cache/dolphin-emu/"
    },
    "native_xdg": {
      "config_root": "${XDG_CONFIG_HOME:-~/.config}/dolphin-emu/",
      "data_root": "${XDG_DATA_HOME:-~/.local/share}/dolphin-emu/",
      "cache_root": "${XDG_CACHE_HOME:-~/.cache}/dolphin-emu/",
      "_note": "Used when ~/.dolphin-emu does not exist (or always inside Flatpak)."
    },
    "legacy_single_dir": {
      "root": "~/.dolphin-emu/",
      "config_root": "~/.dolphin-emu/Config/",
      "data_root": "~/.dolphin-emu/",
      "cache_root": "~/.dolphin-emu/Cache/"
    },
    "portable": {
      "root": "<exe dir>/User/ when <exe dir>/portable.txt exists, or $DOLPHIN_EMU_USERPATH",
      "config_root": "<root>/Config/",
      "data_root": "<root>/",
      "cache_root": "<root>/Cache/"
    },
    "files_under_config_root": [
      "Dolphin.ini",
      "GCPadNew.ini",
      "WiimoteNew.ini",
      "Hotkeys.ini",
      "Profiles/GCPad/<name>.ini",
      "Profiles/Wiimote/<name>.ini",
      "Profiles/Hotkeys/<name>.ini"
    ],
    "files_under_data_root": [
      "GameSettings/<GAMEID>.ini",
      "GC/",
      "Wii/",
      "StateSaves/"
    ],
    "files_under_cache_root": [
      "gamelist.cache"
    ]
  },
  "device_ref": {
    "key": "Device",
    "format": "{source}/{index}/{name}",
    "sources": {
      "sdl": "SDL",
      "evdev": "evdev",
      "dsu": "DSUClient",
      "real_wiimote": "Bluetooth"
    },
    "index_semantics": "first free id among devices with the same source AND name, in the order devices were added; so two identical pads are SDL/0/<name> and SDL/1/<name>",
    "name_semantics": "SDL_GetGamepadName(). Under Steam (SteamVirtualGamepadInfo set) SDL returns Steam's name for the physical pad; EmuDeck ships 'SDL/0/Steam Deck Controller'. Without Steam info, the virtual pad is 'Steam Virtual Gamepad' (SDL gamepad DB). [VERIFY] names for other pads through Steam",
    "examples": [
      "SDL/0/Steam Deck Controller",
      "SDL/1/Steam Deck Controller",
      "SDL/0/PS4 Controller",
      "SDL/0/Steam Deck"
    ],
    "sdl_order": "slots",
    "_order_note": "Which pad gets which <index>: Dolphin adds SDL devices in SDL_GetJoysticks() order at populate (SDL.cpp) and gives each the first id free among same-named SDL devices (ControllerInterface::AddDevice). Dolphin bundles SDL3 (Externals/SDL @ fa2c02bb), which lists Steam virtual pads first, sorted by the slot N in 'pad N' (LINUX_ScanSteamVirtualGamepads), and names each after Steam's slot entry (SDL_GetJoystickName, SDL_GetGamepadName when the pad has a Steam handle). So for a virtual pad, name = the slot's name= and index = how many earlier slots have that same name. Confirmed on a Deck (2026-10-22, Game Mode, docked, docs/13 S1): EmuDeck's AutoMap wrote SDL/0/DualSense Wireless Controller, SDL/0/Steam Deck Controller, SDL/0/Nintendo Switch Pro Controller for slots 0-2, i.e. slot names with n = 0 per distinct name. [VERIFY] still: the order when the virtual pads' nodes are out of slot order (that run had them in order), and Desktop Mode, where the Deck's slot is '#SettingsController_SteamController'.",
    "_order_sources": [
      "https://github.com/dolphin-emu/dolphin/blob/2c805fee8f232d090c454381bb1b8422242345e1/Source/Core/InputCommon/ControllerInterface/SDL/SDL.cpp#L265-L306",
      "https://github.com/dolphin-emu/dolphin/blob/2c805fee8f232d090c454381bb1b8422242345e1/Source/Core/InputCommon/ControllerInterface/ControllerInterface.cpp#L249-L271",
      "https://github.com/dolphin-emu/dolphin/blob/2c805fee8f232d090c454381bb1b8422242345e1/Source/Core/InputCommon/ControllerInterface/SDL/SDLGamepad.cpp#L22-L27",
      "https://github.com/libsdl-org/SDL/blob/fa2c02bb6e21974a89ea9824bc53c9932abe5f9c/src/joystick/linux/SDL_sysjoystick.c#L867-L965",
      "https://github.com/libsdl-org/SDL/blob/fa2c02bb6e21974a89ea9824bc53c9932abe5f9c/src/joystick/SDL_joystick.c#L980-L1010",
      "https://github.com/libsdl-org/SDL/blob/fa2c02bb6e21974a89ea9824bc53c9932abe5f9c/src/joystick/SDL_joystick.c#L1960-L1982",
      "https://github.com/libsdl-org/SDL/blob/fa2c02bb6e21974a89ea9824bc53c9932abe5f9c/src/joystick/SDL_gamepad.c#L3978-L3986"
    ],
    "per_binding_override": "`SDL/1/PS4 Controller:Button S` (device prefix inside the expression, then ':')"
  },
  "binding_syntax": {
    "quote": "wrap a control name in backticks when it contains any non-letter character (MappingCommon::GetExpressionForControl); bare words are tried as function names first",
    "or": " | ",
    "and_simultaneous": " & ",
    "hotkey_sequence": "@(`Back`+`Start`)",
    "not": "!",
    "unbound": "empty value (key is deleted on save, since empty is the default)",
    "range_key": "<group>/<control>/Range = <percent> (default 100; Modifier default 50)",
    "keys_case_insensitive": true,
    "note": "Sticks have no full-axis token: each direction is its own key with a half-axis token."
  },
