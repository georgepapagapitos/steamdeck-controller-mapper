      "gc": "PadProfile{n}",
      "wii": "WiimoteProfile{n}",
      "n_range": [
        1,
        4
      ]
    },
    "profile_value": "profile name relative to the profile dir, without .ini; may be a comma-separated list or a directory (first match is used)",
    "profile_dir": {
      "gc": "<config_root>/Profiles/GCPad/",
      "wii": "<config_root>/Profiles/Wiimote/"
    },
    "profile_file_section": "Profile",
    "precedence": "If PadProfileN/WiimoteProfileN is set for the running game, that profile replaces the whole [GCPadN]/[WiimoteN] section for that slot. The global file is not read for that slot.",
    "missing_profile": "Dolphin shows 'No profiles found for game setting' and falls back to global for that slot."
  },
  "game_id": {
    "format": "6 ASCII chars, e.g. GALE01 (4-char title code + 2-char maker)",
    "methods": [
      {
        "name": "dolphin-tool",
        "cmd_flatpak": [
          "flatpak",
          "run",
          "--command=dolphin-tool",
          "org.DolphinEmu.dolphin-emu",
          "header",
          "-j",
          "-i",
          "<file>"
        ],
        "cmd_native": [
          "dolphin-tool",
          "header",
          "-j",
          "-i",
          "<file>"
        ],
        "json_keys": [
          "game_id",
          "internal_name",
          "revision",
          "title_id",
          "region",
          "country",
          "block_size",
          "compression_method",
          "compression_level"
        ],
        "_note": "Built when ENABLE_CLI_TOOL=ON (default); the Flathub manifest does not turn it off. Handles every format Dolphin reads. [VERIFY] presence at /app/bin/dolphin-tool on device."
      },
      {
        "name": "header_iso_gcm",
        "offset": 0,
        "length": 6,
        "applies_to": [
          "iso",
          "gcm"
        ]
      },
      {
        "name": "header_wia_rvz",
        "magic": {
          "WIA": "57 49 41 01",
          "RVZ": "52 56 5A 01"
        },
        "offset": 88,
        "offset_hex": "0x58",
        "length": 6,
        "_note": "WIAHeader1 is 0x48 bytes; WIAHeader2 starts with 4 u32 fields then disc_header[0x80]"
      },
      {
        "name": "gcz",
        "magic": "01 C0 0B B1",
        "_note": "deflate-compressed blocks; use dolphin-tool"
      },
      {
        "name": "gamelist_cache",
        "path": "<cache_root>/gamelist.cache",
        "format": "PointerWrap binary, header {u32 revision=27, u64 size}, std::map fields; not stable across versions. Do not parse."
      }
    ]
  },
