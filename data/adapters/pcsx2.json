    "never_touch": [
      "[UI] SettingsVersion (if missing or != 1, PCSX2 resets every setting to defaults)",
      "[Folders]"
    ]
  },
  "save_behaviour": {
    "on_change": "Host::CommitBaseSettingChanges starts a single-shot timer, then QtHost::SaveSettings writes the whole PCSX2.ini from memory",
    "exit": "QtHost main saves PCSX2.ini again if dirty",
    "migration": "SDL2-style bindings (SDL-0/A, +Axis6, Button21) are rewritten in place on first load",
    "_implication": "Write only while PCSX2 is not running. External edits made while it runs are lost at its next save."
  }
}
