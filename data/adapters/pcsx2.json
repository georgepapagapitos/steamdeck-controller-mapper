        "small": "SmallMotor"
      },
      "on": {
        "large": "SDL-{p}/LargeMotor",
        "small": "SDL-{p}/SmallMotor"
      },
      "strength_keys": {
        "LargeMotorScale": {
          "range": [
            0.0,
            2.0
          ],
          "default": 1.0
        },
        "SmallMotorScale": {
          "range": [
            0.0,
            2.0
          ],
          "default": 1.0
        }
      }
    },
    "deadzone": {
