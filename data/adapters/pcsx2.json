  "hotkeys": {
    "section": "Hotkeys",
    "targets": {
      "hotkey.save_state": "SaveStateToSlot",
      "hotkey.load_state": "LoadStateFromSlot",
      "hotkey.menu": "OpenPauseMenu",
      "hotkey.exit": "ShutdownVM",
      "hotkey.fast_forward": "ToggleTurbo",
      "hotkey.fast_forward_hold": "HoldTurbo",
      "hotkey.rewind": null,
      "hotkey.screenshot": "Screenshot",
      "hotkey.next_slot": "NextSaveStateSlot",
      "hotkey.prev_slot": "PreviousSaveStateSlot",
      "hotkey.toggle_fullscreen": "ToggleFullscreen",
      "hotkey.pause": "TogglePause"
    },
    "_note": "hotkey.fast_forward is the toggle (ToggleTurbo); hotkey.fast_forward_hold is HoldTurbo. Chords: 'SDL-0/Back & SDL-0/Start'. Profiles only supply hotkeys when the profile has [Pad] UseProfileHotkeyBindings = true."
  },
  "options": {
    "rumble": {
      "section": "Pad{n}",
      "keys": {
