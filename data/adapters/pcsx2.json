      },
      "button_trigger": {
        "section": "Pad{n}",
        "key": "ButtonDeadzone",
        "range": [
          0.0,
          1.0
        ],
        "default": 0.0
      },
      "per_binding": "<Key>Deadzone"
    },
    "sensitivity": {
      "section": "Pad{n}",
      "key": "AxisScale",
      "range": [
        0.01,
        2.0
      ],
      "default": 1.33
    },
    "invert": {
      "section": "Pad{n}",
      "keys": [
        "InvertL",
        "InvertR"
      ],
      "values": {
        "0": "none",
        "1": "left/right",
        "2": "up/down",
        "3": "both"
      }
    },
    "pressure_modifier": {
      "section": "Pad{n}",
      "key": "PressureModifier",
      "default": 0.5
    },
    "controller_type": {
      "section": "Pad{n}",
      "key": "Type",
      "values": {
        "ps2.dualshock2": "DualShock2",
        "none": "None"
      },
      "other_values": [
        "Guitar",
        "Jogcon",
        "NeGcon",
        "Popn"
      ],
      "defaults": {
        "Pad1": "DualShock2",
        "Pad2..Pad8": "None"
      }
    },
    "multitap": {
      "section": "Pad",
      "keys": {
        "port1": "MultitapPort1",
        "port2": "MultitapPort2"
      },
      "values": [
        true,
        false
      ],
      "default": false,
      "pad_numbering": {
        "Pad1": "port 1 slot A",
        "Pad2": "port 2 slot A",
        "Pad3": "1B",
        "Pad4": "1C",
        "Pad5": "1D",
        "Pad6": "2B",
        "Pad7": "2C",
        "Pad8": "2D"
      }
    },
    "input_sources": {
      "section": "InputSources",
      "keys": {
        "SDL": true,
        "SDLControllerEnhancedMode": "default true",
        "SDLPS5PlayerLED": "default true",
        "SDLRawInput": "default false"
      }
    }
