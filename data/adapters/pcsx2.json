  ],
  "_conventions": "Axis targets and axis sources are objects {neg, pos}. Sign follows SDL: x neg = left, pos = right; y neg = up, pos = down. To bind an axis target to an axis source, write target.neg <- source.neg and target.pos <- source.pos.",
  "paths": {
    "appimage_or_native": {
      "data_root": "${XDG_CONFIG_HOME:-~/.config}/PCSX2/"
    },
    "flatpak": {
      "app_id": "net.pcsx2.PCSX2",
      "data_root": "~/.var/app/net.pcsx2.PCSX2/config/PCSX2/"
    },
    "portable": {
      "data_root": "<exe dir>/<path in portable.txt> when portable.txt/portable.ini exists; AppImage + -portable: <AppImage dir>/PCSX2/"
    },
    "main_ini": "<data_root>/inis/PCSX2.ini",
    "input_profiles": "<data_root>/inputprofiles/<name>.ini  ([Folders] InputProfiles overrides)",
    "game_settings": "<data_root>/gamesettings/  ([Folders] GameSettings overrides)",
    "cache": "<data_root>/cache/  ([Folders] Cache overrides)",
    "_note": "Folder overrides in [Folders] are relative to data_root unless absolute. Read them before resolving paths."
  },
  "device_ref": {
    "format": "SDL-{player_index}",
    "index_semantics": "SDL player index (SDL_GetGamepadPlayerIndex); if negative or taken, first free index. Steam virtual pads report their Steam slot. Index-based: order matters.",
    "persistent_ids": false,
    "other_sources": [
      "Keyboard",
      "Pointer-{n}",
      "XInput-{n}",
      "DInput-{n}"
    ]
  },
  "binding_syntax": {
    "binding": "{device}/{token}, e.g. SDL-0/FaceSouth",
    "chord": " & ",
    "multiple_bindings": "repeat the key on its own line (INI multi-value, read with GetStringList)",
    "half_axis": "+Axis / -Axis prefix, e.g. +LeftTrigger, -LeftY",
    "invert_suffix": "~ (e.g. -JoyAxis2~)",
    "raw_joystick": {
      "button": "JoyButton{n}",
      "axis": "{+|-|Full}JoyAxis{n}",
      "hat": "Hat{n}{North|East|South|West}"
    },
    "per_binding_scale_deadzone": "<Key>Scale, <Key>Deadzone in the same [PadN] section",
    "keyboard": "Keyboard/<Key>",
    "unbound": "delete the key"
  },
