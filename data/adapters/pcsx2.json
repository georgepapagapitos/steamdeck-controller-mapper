  "per_game": {
    "id_type": "serial_crc",
    "file": "<game_settings>/{SanitizeFileName(serial)}_{crc:08X}.ini, fallback <game_settings>/{crc:08X}.ini",
    "profile_key": {
      "section": "EmuCore",
      "key": "InputProfileName"
    },
    "profile_file": "<input_profiles>/{name}.ini",
    "profile_contents": "same sections as PCSX2.ini: [Pad], [Pad1]..[Pad8], [InputSources], [Hotkeys]",
    "precedence": "If InputProfileName names an existing profile, ALL pad bindings come from the profile only (base [PadN] is ignored). Hotkeys come from base unless the profile sets [Pad] UseProfileHotkeyBindings = true. Without a profile, bindings are read through the layered interface cmdline > game ini > input profile > base, so a game ini may also hold [PadN] keys that shadow base ones key by key."
  },
  "game_id": {
    "format": "serial like SLUS-20312 plus 32-bit CRC of the boot ELF (hex, upper case, 8 digits)",
    "methods": [
      {
        "name": "gamelist_cache",
        "path": "<cache>/gamelist.cache",
        "header": {
          "signature_u32le": "0x45434C47",
          "version_u32le": 34
        },
        "entry": [
          "str path",
          "str serial",
          "str title",
          "str title_sort",
          "str title_en",
          "u8 type",
          "u8 region",
          "u64 total_size",
          "u64 last_modified_time",
          "u32 crc",
          "u8 compatibility_rating"
        ],
        "string": "u32le length + bytes (no terminator)",
        "_note": "Little endian. Append-only: later entries for the same path win. Version changes reset the file; check version before parsing."
      },
      {
        "name": "system_cnf",
        "applies_to": [
          "iso"
        ],
        "_note": "ISO9660 SYSTEM.CNF 'BOOT2 = cdrom0:\\SLUS_203.12;1' -> SLUS-20312. Gives serial only (CRC needs the ELF)."
      },
      {
        "name": "filename",
        "_note": "weak: '(SLUS-20312)' in file name"
      }
    ]
  },
  "managed_keys": {
    "PCSX2.ini": {
