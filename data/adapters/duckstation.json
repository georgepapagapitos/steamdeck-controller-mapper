        "LRight",
        "RUp",
        "RDown",
        "RLeft",
        "RRight",
        "LargeMotor",
        "SmallMotor",
        "AnalogDeadzone",
        "ButtonDeadzone",
        "AnalogSensitivity",
        "ForceAnalogOnReset (options only)"
      ],
      "ControllerPorts": [
        "MultitapMode (only for >2 players)"
      ],
      "Hotkeys": [
        "only hotkey targets with rules"
      ]
    },
    "never_touch": [
      "[Main] SettingsVersion / SetupWizardIncomplete",
      "[Folders]"
    ]
  },
  "save_behaviour": {
    "on_change": "Host::CommitBaseSettingChanges -> 1 s single-shot timer (SETTINGS_SAVE_DELAY) -> QtHost::SaveSettings writes settings.ini",
    "exit": "pending timer is flushed on shutdown",
    "_implication": "Write only while DuckStation is not running."
  }
}
