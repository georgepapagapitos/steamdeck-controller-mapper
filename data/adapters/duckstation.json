  "hotkeys": {
    "section": "Hotkeys",
    "targets": {
      "hotkey.save_state": "SaveSelectedSaveState",
      "hotkey.load_state": "LoadSelectedSaveState",
      "hotkey.menu": "OpenPauseMenu",
      "hotkey.exit": "PowerOff",
      "hotkey.fast_forward": "ToggleFastForward",
      "hotkey.fast_forward_hold": "FastForward",
      "hotkey.rewind": "Rewind",
      "hotkey.screenshot": "Screenshot",
      "hotkey.next_slot": "SelectNextSaveStateSlot",
      "hotkey.prev_slot": "SelectPreviousSaveStateSlot",
      "hotkey.toggle_fullscreen": "ToggleFullscreen",
      "hotkey.pause": "TogglePause"
    },
    "_note": "hotkey.fast_forward is the toggle (ToggleFastForward, EmuDeck's Select+R2); hotkey.fast_forward_hold is FastForward (hold). Rewind needs [Main] RewindEnable = true. EmuDeck binds several hotkeys twice (keyboard + pad) by repeating the key."
  },
  "options": {
    "rumble": {
      "section": "Pad{n}",
      "keys": {
        "large": "LargeMotor",
        "small": "SmallMotor"
      },
      "on": {
        "large": "SDL-{p}/LargeMotor",
        "small": "SDL-{p}/SmallMotor"
      },
      "strength_keys": {
        "LargeMotorVibrationBias": {
          "range": [
            -255,
            255
          ],
          "default": 8
        },
        "SmallMotorVibrationBias": {
          "range": [
            -255,
            255
          ],
          "default": 8
        }
      }
    },
    "deadzone": {
      "stick": {
        "section": "Pad{n}",
        "key": "AnalogDeadzone",
        "range": [
          0.0,
          1.0
        ],
        "default": 0.0
      },
      "button_trigger": {
        "section": "Pad{n}",
        "key": "ButtonDeadzone",
        "range": [
          0.01,
          1.0
        ],
        "default": 0.25
      },
      "per_binding": "<Key>Deadzone"
    },
    "sensitivity": {
      "section": "Pad{n}",
      "key": "AnalogSensitivity",
      "range": [
        0.01,
        2.0
      ],
      "default": 1.33
    },
    "invert": {
      "section": "Pad{n}",
      "keys": [
        "InvertLeftStick",
        "InvertRightStick"
      ],
      "values": {
        "0": "none",
        "1": "left/right",
        "2": "up/down",
        "3": "both"
      }
    },
    "force_analog": {
      "section": "Pad{n}",
      "key": "ForceAnalogOnReset",
      "default": true
    },
    "analog_dpad_in_digital_mode": {
      "section": "Pad{n}",
      "key": "AnalogDPadInDigitalMode",
      "default": true
    },
    "controller_type": {
      "section": "Pad{n}",
      "key": "Type",
      "values": {
        "psx.dualshock": "AnalogController",
        "psx.digital": "DigitalController",
        "none": "None"
      },
      "other_values": [
        "AnalogJoystick",
        "GunCon",
        "PlayStationMouse",
        "NeGcon",
        "NeGconRumble",
        "Justifier",
        "PopnController",
        "DDGoController",
        "JogCon"
      ],
      "defaults": {
        "Pad1": "AnalogController",
        "Pad2..Pad8": "None"
      }
    },
    "multitap": {
      "section": "ControllerPorts",
      "key": "MultitapMode",
      "values": [
        "Disabled",
        "Port1Only",
        "Port2Only",
        "BothPorts"
      ],
      "default": "Disabled",
      "pad_numbering": {
        "Pad1": "port 1 slot A",
        "Pad2": "port 2 slot A",
        "Pad3": "1B",
        "Pad4": "1C",
        "Pad5": "1D",
        "Pad6": "2B",
        "Pad7": "2C",
        "Pad8": "2D"
      }
    },
    "input_sources": {
      "section": "InputSources",
      "keys": {
        "SDL": true,
        "SDLControllerEnhancedMode": "default false",
        "SDLPS5PlayerLED": "default false",
        "SDLUsePersistentDeviceIdentifiers": "default true (2026-10+)"
      }
    }
  },
  "per_game": {
    "id_type": "serial",
    "file": "<game_settings>/{SanitizeFileName(serial)}.ini; for multi-disc sets, the serial of the first disc",
    "profile_key": {
      "section": "ControllerPorts",
      "key": "InputProfileName"
    },
    "own_bindings_key": {
      "section": "ControllerPorts",
      "key": "UseGameSettingsForController",
      "value": true,
      "_note": "game ini then holds its own [PadN]/[ControllerPorts]; InputProfileName is ignored when this is true"
    },
    "profile_file": "<input_profiles>/{name}.ini",
    "precedence": "Exactly one controller layer is used: input profile, else game ini (only with UseGameSettingsForController = true), else base settings.ini. Hotkeys come from base unless the chosen layer has [ControllerPorts] UseProfileHotkeyBindings = true; input-source settings likewise need UseProfileInputSources = true."
  },
  "game_id": {
    "format": "serial like SLUS-00594",
    "methods": [
      {
        "name": "gamelist_cache",
        "path": "<cache>/gamelist.cache",
        "header": {
          "signature_u32le": "0x45434C48",
          "version_u32le": 41
        },
        "entry": [
          "u8 type",
          "u8 region",
          "str path",
          "str serial",
          "str title",
          "u64 hash",
          "s64 file_size",
          "u64 uncompressed_size",
          "u64 last_modified_time",
          "s8 disc_set_index",
          "u8[16] achievements_hash"
        ],
        "string": "u32le length + bytes",
        "_note": "Little endian; later entries for the same path win. DuckStation opens the file locked while scanning; read it before launch."
      },
      {
        "name": "system_cnf",
        "applies_to": [
          "bin/cue",
          "iso"
        ],
        "_note": "SYSTEM.CNF 'BOOT = cdrom:\\SLUS_005.94;1' -> SLUS-00594. CHD: use the cache."
      }
    ]
  },
  "managed_keys": {
    "settings.ini": {
      "Pad{n}": [
        "Type (only with options.controller_type)",
        "Up",
        "Down",
        "Left",
        "Right",
        "Cross",
        "Circle",
        "Square",
        "Triangle",
        "Select",
