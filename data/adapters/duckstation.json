  ],
  "_conventions": "Axis targets and axis sources are objects {neg, pos}. Sign follows SDL: x neg = left, pos = right; y neg = up, pos = down. To bind an axis target to an axis source, write target.neg <- source.neg and target.pos <- source.pos.",
  "paths": {
    "appimage_or_native": {
      "data_root": "$XDG_CONFIG_HOME/duckstation/ if XDG_CONFIG_HOME is set and absolute, else ~/.local/share/duckstation/"
    },
    "flatpak": {
      "app_id": "org.duckstation.DuckStation",
      "data_root": "~/.var/app/org.duckstation.DuckStation/config/duckstation/",
      "_note": "Flatpak sets XDG_CONFIG_HOME. EmuDeck migrates Flatpak users to the AppImage."
    },
    "portable": {
      "data_root": "<AppImage dir or exe dir> when portable.txt or settings.ini exists there"
    },
    "main_ini": "<data_root>/settings.ini",
    "input_profiles": "<data_root>/inputprofiles/<name>.ini  ([Folders] InputProfiles overrides)",
    "game_settings": "<data_root>/gamesettings/<SERIAL>.ini  ([Folders] GameSettings overrides)",
    "cache": "<data_root>/cache/  ([Folders] Cache overrides)"
  },
  "device_ref": {
    "format": "SDL-{player_index}",
    "persistent_format": "SDL-{sdl_guid}-{serial} (serial of [A-Za-z0-9-] only) or SDL-SB-{sdl_guid}-{hex(serial)}",
    "persistent_ids": "[InputSources] SDLUsePersistentDeviceIdentifiers, default true. Used when DuckStation saves a binding and the device has a serial; numeric SDL-N is always still accepted on load.",
    "index_semantics": "SDL player index, else first free index (same as PCSX2).",
    "_note": "Persistent ids landed in commit edd41dff15 (2026-09-25), first in the 'latest' release of 2026-10-13. Steam virtual pads likely have no serial, so they stay SDL-N. [VERIFY]"
  },
  "binding_syntax": {
    "binding": "{device}/{token}, e.g. SDL-0/FaceSouth",
    "chord": " & ",
    "multiple_bindings": "repeat the key on its own line (INI multi-value, read with GetStringList)",
    "half_axis": "+Axis / -Axis prefix, e.g. +LeftTrigger, -LeftY",
    "invert_suffix": "~ (e.g. -JoyAxis2~)",
    "raw_joystick": {
      "button": "Button{n}",
      "axis": "+Axis{n} / -Axis{n} / FullAxis{n}",
      "hat": "Hat{n}{North|East|South|West}"
    },
    "per_binding_scale_deadzone": "<Key>Scale, <Key>Deadzone in the same [PadN] section",
    "keyboard": "Keyboard/<Key>",
    "unbound": "delete the key",
    "leds": {
      "rgb": "RGBLED",
      "mute": "MuteLED"
    }
  },
