{
  "schema_version": 1,
  "adapter": "duckstation",
  "version_range": "DuckStation since commit 4e97420b3b (SDL3, 2025-01-24; every v0.1-10339+ tag) .. 'latest' release 2026-10-13 and master b3d57a7f47 (2026-10-22)",
