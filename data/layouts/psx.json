{
  "schema_version": 1,
  "system": "psx",
  "name": "Sony PlayStation",
  "controllers": {
    "digital": {
      "buttons": ["cross", "circle", "square", "triangle", "l1", "r1", "l2", "r2", "start", "select"],
      "dpad": ["up", "down", "left", "right"],
      "analog": [],
      "rumble": false
    },
    "dualshock": {
      "buttons": ["cross", "circle", "square", "triangle", "l1", "r1", "l2", "r2", "l3", "r3", "start", "select", "analog"],
      "dpad": ["up", "down", "left", "right"],
      "analog": ["lstick_x", "lstick_y", "rstick_x", "rstick_y"],
      "rumble": true
    }
  },
  "default_controller": "dualshock",
  "glyphs": {
    "cross": "✕", "circle": "○", "square": "□", "triangle": "△",
    "l1": "L1", "r1": "R1", "l2": "L2", "r2": "R2", "l3": "L3", "r3": "R3",
    "start": "START", "select": "SELECT", "analog": "ANALOG"
  },
  "positional_default": {
    "digital": {
      "cross": "face_south", "circle": "face_east", "square": "face_west", "triangle": "face_north",
      "l1": "l1", "r1": "r1", "l2": "l2", "r2": "r2", "start": "start", "select": "select",
      "up": "dpad_up", "down": "dpad_down", "left": "dpad_left", "right": "dpad_right"
    },
    "dualshock": {
      "cross": "face_south", "circle": "face_east", "square": "face_west", "triangle": "face_north",
      "l1": "l1", "r1": "r1", "l2": "l2", "r2": "r2", "l3": "l3", "r3": "r3",
      "start": "start", "select": "select", "analog": "none",
      "up": "dpad_up", "down": "dpad_down", "left": "dpad_left", "right": "dpad_right",
      "lstick_x": "ls_x", "lstick_y": "ls_y", "rstick_x": "rs_x", "rstick_y": "rs_y"
    }
