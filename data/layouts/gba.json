{
  "schema_version": 1,
  "system": "gba",
  "name": "Nintendo Game Boy Advance",
  "controllers": {
    "standard": {
      "buttons": ["a", "b", "l", "r", "start", "select"],
      "dpad": ["up", "down", "left", "right"],
      "analog": [],
      "rumble": true
    }
  },
  "default_controller": "standard",
  "glyphs": { "a": "A", "b": "B", "l": "L", "r": "R", "start": "START", "select": "SELECT" },
  "positional_default": {
    "standard": {
      "b": "face_south", "a": "face_east", "l": "l1", "r": "r1", "start": "start", "select": "select",
      "up": "dpad_up", "down": "dpad_down", "left": "dpad_left", "right": "dpad_right"
    }
  },
  "label_positions": { "a": "east", "b": "west" },
  "meta": { "confirm": "standard.a", "cancel": "standard.b", "primary": "standard.a", "secondary": "standard.b" },
  "_notes": "rumble=true for cart rumble (Drill Dozer, WarioWare Twisted), which mGBA forwards. Cart sensors (tilt in Yoshi Topsy-Turvy, gyro in WarioWare Twisted, solar in Boktai) are not listed as inputs yet; they belong in options (gyro/motion_provider) if we support them."
}
